{
  "name": "@bzync/rui",
  "version": "0.0.7",
  "description": "Bzync React Tailwind UI component library",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js",
      "require": "./dist/components/*.cjs"
    },
    "./*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js",
      "require": "./dist/components/*.cjs"
    },
    "./styles.css": {
      "style": "./dist/styles.css",
      "import": "./dist/styles.css",
      "default": "./dist/styles.css"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "release:check": "npm run typecheck && npm run test:unit && npm run build && npm --prefix demo run build && npm run test:e2e",
    "prepublishOnly": "npm run release:check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bzync/rui.git"
  },
  "keywords": [
    "react",
    "react-components",
    "component-library",
    "components",
    "ui",
    "ui-components",
    "ui-library",
    "react-ui",
    "tailwind",
    "tailwindcss",
    "tailwind-css",
    "design-system",
    "typescript",
    "typescript-react",
    "dark-mode",
    "light-mode",
    "theme",
    "theming",
    "accessible",
    "a11y",
    "wai-aria",
    "headless",
    "primitives",
    "hooks",
    "esm",
    "cjs",
    "tree-shakeable",
    "zero-dependencies",
    "no-dependencies",
    "rsc",
    "react-server-components",
    "react-18",
    "react-19",
    "charts",
    "data-table",
    "datatable",
    "forms",
    "form-validation",
    "modal",
    "dialog",
    "dropdown",
    "tooltip",
    "date-picker",
    "framer-motion"
  ],
  "author": "Rayan Reynaldo (https://www.bzync.com)",
  "maintainers": [
    {
      "name": "Rayan Reynaldo",
      "url": "https://www.bzync.com"
    }
  ],
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/bzync/rui/issues"
  },
  "homepage": "https://github.com/bzync/rui#readme",
  "peerDependencies": {
    "framer-motion": "^13.1.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "framer-motion": "^13.1.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.11"
  }
}
