{
  "id": "/",
  "name": "@bzync/rui Component Library",
  "short_name": "rui Docs",
  "description": "Documentation, examples, and component reference for @bzync/rui.",
  "start_url": "/#/docs/introduction",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#f6f8fb",
  "theme_color": "#172033",
  "orientation": "any",
  "categories": ["developer-tools", "productivity"],
  "icons": [
    {
      "src": "/rui-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/rui-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Components",
      "short_name": "Components",
      "url": "/#/components",
      "icons": [{ "src": "/rui-icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Examples",
      "short_name": "Examples",
      "url": "/#/examples/settings",
      "icons": [{ "src": "/rui-icon-192.png", "sizes": "192x192" }]
    }
  ]
